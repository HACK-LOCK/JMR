# ---------------------------------------------------------------------------
# Copy this file to ".env" (project root) and fill in your values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=4000
NODE_ENV=development

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma separated list of origins allowed to call the API.
# Leave empty for same-origin only (recommended when the PWA is served by the API).
CORS_ORIGINS=

# --- Online database (Supabase Postgres) ---
# Setting DATABASE_URL is what switches the app from a file on this computer to
# the shop's online database. Read docs/SUPABASE_SETUP.md before filling it in:
# the two URLs below are not interchangeable and the wrong one will not work.
#
# Leave BOTH empty to run on the local file (development and the test suite).

# The URL the RUNNING APP uses. Use the Supabase "Session pooler" host
# (aws-0-<region>.pooler.supabase.com) on port 5432, with the limited role
# printed by "npm run db:setup". Session mode, not transaction mode: the app
# relies on a database lock that transaction mode would not hold.
DATABASE_URL=

# Only used once, by "npm run db:setup", to create the tables and the limited
# role. This is the Supabase superuser password. EMPTY THIS OUT after setup -
# the running app never needs it, and leaving it here puts full access to the
# whole project in one file.
POSTGRES_ADMIN_URL=

# How many database connections the app may hold. A shop counter needs very few.
DATABASE_POOL_MAX=10

# How often (milliseconds) a screen left open re-reads the shop, so a bill taken
# on one phone appears on another. 0 turns it off, which is right for a single
# till. The server answers from memory, so this is cheap.
DB_REFRESH_MS=2000

# --- Google Sheets as a read-only copy ---
# With DATABASE_URL set, a connected spreadsheet is a COPY of the shop's records
# for reading in Excel. It only ever receives: bills are edited in the app, and
# editing a cell in the spreadsheet cannot change a bill, a payment or stock.
# Set to false to run the database with no spreadsheet copy at all.
SHEETS_MIRROR=true

# --- Google Cloud (optional) ---
# Create a Google Cloud project, enable "Google Sheets API" and "Google Drive API",
# create a Service Account, then share your Google Sheet with the service account email.
#
# Leave GOOGLE_SHEETS_ID empty to run in LOCAL mode (data stored in backend/.data).
# The app stays fully functional; you can connect Google later from Settings > Sheet Sync.

# ID of the spreadsheet that stores business data (found in the sheet URL)
GOOGLE_SHEETS_ID=

# Folder ID that contains the bill PDFs. Leave empty to auto-create:
#   <GOOGLE_DRIVE_ROOT_FOLDER_ID>/Jai Mataji Mobile Repairing/Bills/<Year>/<Month>
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Service Account credentials. EITHER inline JSON below, OR point to a file.
#   "type": "service_account", "project_id": "...", "private_key_id": "...",
#   "client_email": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
#   "client_id": "...", "project_number": "..."
GOOGLE_SERVICE_ACCOUNT_JSON=

# Path to a service account JSON key file (alternative to inline JSON above)
GOOGLE_SERVICE_ACCOUNT_FILE=

# Google Workspace user to impersonate (optional, for shared-drive access)
GOOGLE_IMPERSONATE_USER=

# --- Data safety ---
# false = never allow stock to go below zero (recommended)
ALLOW_NEGATIVE_STOCK=false

# --- Stock area PIN ---
# The Stock screen asks for this PIN on top of the login, so stock numbers are
# not opened by accident. Leave it EMPTY to accept the signed in person's own
# account password instead (nothing shared, nothing hard coded in the app).
# It lives only in this file on the server and is never sent to the browser.
STOCK_PIN=
# How long one stock unlock lasts before the PIN is asked again (minutes).
STOCK_PIN_TTL_MINUTES=120
# Wrong PIN tries before the PIN is blocked for a minute.
STOCK_PIN_MAX_ATTEMPTS=5

# --- First owner account ---
# Used ONLY by "npm run db:setup" and by the local file mode, to create the first
# owner login. With DATABASE_URL set, setup creates this account in the database
# and the running app never creates one itself.
#
# If OWNER_PASSWORD is left empty, setup GENERATES a password and prints it once.
# Do that for the real shop: a known default password that reaches a real
# database is the whole account system for nothing.
OWNER_NAME=Ashok Bhai
OWNER_USERNAME=ashok
OWNER_PASSWORD=
