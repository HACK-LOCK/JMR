# ---------------------------------------------------------------------------
# Copy this file to ".env" (project root) and fill in your values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=4000
NODE_ENV=development

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma separated list of origins allowed to call the API.
# Leave empty for same-origin only (recommended when the PWA is served by the API).
CORS_ORIGINS=

# --- Google Cloud (optional) ---
# Create a Google Cloud project, enable "Google Sheets API" and "Google Drive API",
# create a Service Account, then share your Google Sheet with the service account email.
#
# Leave GOOGLE_SHEETS_ID empty to run in LOCAL mode (data stored in backend/.data).
# The app stays fully functional; you can connect Google later from Settings > Sheet Sync.

# ID of the spreadsheet that stores business data (found in the sheet URL)
GOOGLE_SHEETS_ID=

# Folder ID that contains the bill PDFs. Leave empty to auto-create:
#   <GOOGLE_DRIVE_ROOT_FOLDER_ID>/Jai Mataji Mobile Repairing/Bills/<Year>/<Month>
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Service Account credentials. EITHER inline JSON below, OR point to a file.
#   "type": "service_account", "project_id": "...", "private_key_id": "...",
#   "client_email": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
#   "client_id": "...", "project_number": "..."
GOOGLE_SERVICE_ACCOUNT_JSON=

# Path to a service account JSON key file (alternative to inline JSON above)
GOOGLE_SERVICE_ACCOUNT_FILE=

# Google Workspace user to impersonate (optional, for shared-drive access)
GOOGLE_IMPERSONATE_USER=

# --- Data safety ---
# false = never allow stock to go below zero (recommended)
ALLOW_NEGATIVE_STOCK=false

# --- Stock area PIN ---
# The Stock screen asks for this PIN on top of the login, so stock numbers are
# not opened by accident. Leave it EMPTY to accept the signed in person's own
# account password instead (nothing shared, nothing hard coded in the app).
# It lives only in this file on the server and is never sent to the browser.
STOCK_PIN=
# How long one stock unlock lasts before the PIN is asked again (minutes).
STOCK_PIN_TTL_MINUTES=120
# Wrong PIN tries before the PIN is blocked for a minute.
STOCK_PIN_MAX_ATTEMPTS=5

# --- First owner account (created automatically on first run) ---
OWNER_NAME=Ashok Bhai
OWNER_USERNAME=ashok
OWNER_PASSWORD=shop1234
