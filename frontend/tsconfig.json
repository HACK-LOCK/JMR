{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "scripts", "vite.config.ts", "vite.render-check.config.ts", "../shared"],
  "exclude": [
    "src/pages/Billing.tsx",
    "src/pages/NewRepair.tsx",
    "src/pages/Parts.tsx",
    "src/pages/Pickup.tsx",
    "src/pages/StockIn.tsx",
    "src/pages/StockOut.tsx",
    "src/pages/StockOverview.tsx",
    "src/pages/Suppliers.tsx"
  ]
}
